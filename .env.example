# Development-only alternative to entering a BYOK key manually in Settings.
# This launch-time value is a fallback when no manual key is saved in Settings.
# Never commit a real key.
OPENAI_API_KEY=

# Optional launch-time coaching-model override. When set, it takes precedence
# over the model selected in Settings until the variable is removed and the app
# is restarted. Recommended Settings choices are gpt-6-astra, gpt-5.6-terra,
# and gpt-5.6-luna; project access and charges still apply.
OPENAI_MODEL=gpt-6-astra

# Optional OpenRouter fallback key and launch-time model override.
# A key entered in Settings overrides this fallback key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
